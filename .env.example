APP_NAME="المخبر العماني"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- قاعدة البيانات (تشغيل محلي على الجهاز؛ الحاويات تتجاوز HOST/PORT) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=omanilab
DB_FORWARD_PORT=5434
DB_OWNER_USERNAME=omani
DB_OWNER_PASSWORD=
DB_USERNAME=omani
DB_PASSWORD=
# أدوار التشغيل (غيّرها في الإنتاج)
DB_APP_READER_PASSWORD=
DB_INGEST_WRITER_PASSWORD=
DB_PROMOTER_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=null
REDIS_QUEUE_RETRY_AFTER=1800
SESSION_DRIVER=cookie
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_FORWARD_PORT=6381
APP_PORT=8100

# --- تيليجرام (اتركه فارغًا لتسجيل التنبيهات في السجل فقط) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# رمز وكيل الذكاء الاصطناعي لواجهة /api/agent (اتركه فارغًا لتعطيلها؛ ولّد قيمة طويلة عشوائية).
AGENT_TOKEN=
